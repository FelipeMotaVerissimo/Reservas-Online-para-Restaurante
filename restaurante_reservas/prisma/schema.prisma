generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum StatusReserva {
  pendente
  confirmada
  cancelada
}

model Reserva {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String
  telefone String
  data     DateTime
  pessoas  Int
  status   String   @default("pendente")
  criadoEm DateTime @default(now())
}



model Usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String
}
